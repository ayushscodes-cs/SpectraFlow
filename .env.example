# Presage SmartSpectra API Key Configuration
# Obtain your key from https://physiology.presagetech.com/auth/register
SMARTSPECTRA_API_KEY=your_presage_api_key_here

# Hardware camera ID (optional - leave blank to auto-detect default)
CAMERA_DEVICE_ID=

# Dev mode simulator toggle (true/false) - explicitly labelled in UI if active
DEV_SIMULATOR=false
